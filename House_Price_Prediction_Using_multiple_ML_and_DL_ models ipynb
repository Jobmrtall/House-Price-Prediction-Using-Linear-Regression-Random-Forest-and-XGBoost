        "    scoring='r2',\n",
        "    n_jobs=-1,\n",
        "    random_state=42\n",
        ")\n",
        "lasso_search.fit(X_train, y_train)\n",
        "y_pred_lasso = lasso_search.predict(X_val)\n",
